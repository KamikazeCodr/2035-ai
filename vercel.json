{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/AI-2035.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/supplement/:slug",
      "destination": "/supplements/:slug.html"
    },
    {
      "source": "/supplements/:slug",
      "destination": "/supplements/:slug.html"
    },
    {
      "source": "/supplements",
      "destination": "/supplements.html"
    },
    {
      "source": "/supplement",
      "destination": "/supplements.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/old-version",
      "destination": "/old-version/index.html"
    },
    {
      "source": "/old-version/",
      "destination": "/old-version/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/code",
      "destination": "https://github.com/KamikazeCodr/2035-ai",
      "permanent": true
    },
    {
      "source": "/audio",
      "destination": "https://open.spotify.com/episode/4KZn62TiEdh95sh589PWgk",
      "permanent": true
    },
    {
      "source": "/pdf",
      "destination": "https://2035-ai.com/AI-2035.pdf",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "https://2035-ai.com/supplements",
      "permanent": true
    }
  ]
}